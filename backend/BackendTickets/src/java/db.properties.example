# Todo en una sola máquina (examen final):
db.url=jdbc:sqlserver://localhost:1433;databaseName=DB_ControlTickets;encrypt=true;trustServerCertificate=true;

# Presentación en red (servidor de BD en otra PC): cambie localhost por la IP de esa PC.
# db.url=jdbc:sqlserver://192.168.1.10:1433;databaseName=DB_ControlTickets;encrypt=true;trustServerCertificate=true;

db.user=tickets_app
